{
  servers {
    # Disable HTTP/3 (QUIC) because some networks/browsers intermittently fail
    # large streamed downloads with ERR_QUIC_PROTOCOL_ERROR.
    protocols h1 h2
  }
}

adsconnect.com.au, www.adsconnect.com.au {
  @compressible not path /api/campaign-images/* /campaign-files/*
  encode @compressible zstd gzip

  handle_path /campaign-files/* {
    root * /shared-storage/uploads/campaign-images
    header {
      Cache-Control "private, no-store, no-transform"
      X-Content-Type-Options nosniff
    }
    file_server
  }

  # Serve public campaign artwork through the CDN while keeping a same-origin
  # URL for browser canvas/PDF generation. This bypasses the slower API relay.
  handle_path /campaign-artwork-cdn/* {
    reverse_proxy https://adsartwork.syd1.cdn.digitaloceanspaces.com {
      header_up Host adsartwork.syd1.cdn.digitaloceanspaces.com
    }
  }

  @api path /api/*
  handle @api {
    reverse_proxy api:4000
  }

  handle {
    reverse_proxy web:3000
  }

  header {
    X-Content-Type-Options nosniff
    X-Frame-Options SAMEORIGIN
    Referrer-Policy strict-origin-when-cross-origin
  }
}
